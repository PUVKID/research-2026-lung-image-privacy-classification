+    "    y_true_onehot = np.concatenate(y_true_list, axis=0)\n",
+    "    y_true        = np.argmax(y_true_onehot, axis=1)\n",
+    "\n",
+    "    all_fold_preds = []\n",
+    "    for fold, mp in enumerate(fold_models):\n",
+    "        fm = load_model(mp, custom_objects={\"loss_fn\": focal_loss(2.0, 0.05)})\n",
+    "        tta_preds = []\n",
