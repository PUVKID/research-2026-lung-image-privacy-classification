+    "        font=font\n",
+    "    )\n",
+    "\n",
+    "    text_w = bbox[2] - bbox[0]\n",
+    "    text_h = bbox[3] - bbox[1]\n",
+    "\n",
+    "    # 가운데 정렬\n",
+    "    x = (w - text_w) // 2\n",
+    "\n",
+    "    # 라벨 영역 중앙 정렬\n",
+    "    y = (\n",
+    "        h\n",
+    "        + (label_area_h - text_h) // 2\n",
+    "        - bbox[1]\n",
