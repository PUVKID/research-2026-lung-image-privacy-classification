+        "\n",
+        "# 1. 전체 정확도 막대 ────────────────────────────────────────────────────\n",
+        "print(\"\\n📊 [종합 1/10] 전체 정확도 막대\")\n",
+        "fig, ax = plt.subplots(figsize=(22, 5))\n",
