+    "    \"RGB\",\n",
+    "    (grid_w, grid_h),\n",
+    "    \"white\"\n",
+    ")\n",
+    "\n",
+    "positions = [\n",
+    "    (0, 0),\n",
+    "    (cell_w, 0),\n",
+    "    (0, cell_h),\n",
+    "    (cell_w, cell_h)\n",
