+        "        if (ta - va > 0.18) and (vl - tl > 0.20): over += 1\n",
+        "        elif ta < 0.65 and va < 0.65:              under += 1\n",
+        "        else:                                       good  += 1\n",
+        "    return good, over, under\n",
+        "\n",
+        "CMAP = plt.cm.plasma\n",
