+    "from PIL import Image, ImageDraw, ImageFont\n",
+    "import os\n",
+    "\n",
+    "# =========================================================\n",
+    "# 1. 경로 설정\n",
+    "# =========================================================\n",
+    "\n",
+    "image_paths = [\n",
+    "    r\".\\Train\\Bengin cases\\Bengin case (1).jpg\",\n",
