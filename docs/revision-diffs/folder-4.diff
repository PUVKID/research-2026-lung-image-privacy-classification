+        "    if not arrs:\n",
+        "        return np.zeros((1, 10))\n",
+        "    max_len = max(len(a) for a in arrs)\n",
+        "    mat = [a + [a[-1]] * (max_len - len(a)) for a in arrs]\n",
+        "    return np.array(mat)\n",
+        "\n",
+        "def _fit_status(folds_data):\n",
