+        "                         os.path.join(kfold_dir, cls, f))\n",
+        "\n",
+        "        print(f\"    {cls}: 원본 {len(files)}장 → kfold={len(files)-n_test}, test={n_test} (aug_ 없음)\")\n",
+        "\n",
+        "    for cls in list_class_dirs(test_dir):\n",
