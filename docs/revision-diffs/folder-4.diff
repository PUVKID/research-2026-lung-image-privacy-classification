+      "source": [
+        "# Cell 14: 훈련 후 평가 그래프 110개 (종합 10 + 블록별 10×10)\n",
+        "# 한글·기호 완전 지원 / 폴더 자동 생성\n",
+        "# ─────────────────────────────────────────────────────────────────────────\n",
+        "import itertools, os\n",
+        "import numpy as np\n",
