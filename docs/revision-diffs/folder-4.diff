+        "print(\"=\"*60)\n",
+        "\n",
+        "_all_keys    = [_ckey(bs, sg) for bs, sg in _GRAPH_CONDITIONS]\n",
+        "_all_labels  = [_clabel_short(bs, sg) for bs, sg in _GRAPH_CONDITIONS]\n",
