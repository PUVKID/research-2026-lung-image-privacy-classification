+        "    if val >= 85: return '#2ea043'\n",
+        "    if val >= 75: return '#7ec852'\n",
+        "    if val >= 65: return '#d4e052'\n",
+        "    if val >= 55: return '#e8a838'\n",
+        "    if val >= 45: return '#e86b38'\n",
+        "    return '#c0392b'\n",
+        "\n",
+        "BAR_COLORS = [acc_color(a) for a in accs]\n",
+        "\n",
