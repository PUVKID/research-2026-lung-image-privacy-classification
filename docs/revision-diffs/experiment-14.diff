+   "source": [
+    "# Cell 3: 실험 설정 — 환경에 맞게 BASE_TRAIN만 확인\n",
+    "BASE_TRAIN   = \"/workspace/Train\"      # 원본(비암호화) 이미지 루트. 정확도 실험 노트북과 동일 경로\n",
+    "IMG_SIZE     = 512\n",
+    "SEED         = 42                       # block_scramble에 쓰인 것과 동일 시드\n",
+    "IMAGE_EXTENSIONS = (\".jpg\", \".jpeg\", \".png\", \".bmp\")\n",
