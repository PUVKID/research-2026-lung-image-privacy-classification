+    "x_idx = np.arange(n_bs)\n",
+    "width = 0.25\n",
+    "\n",
+    "fig, ax = plt.subplots(figsize=(14, 5.5))\n",
+    "for ci, (cls, ko, c) in enumerate(zip(_CLASS_NAMES, _CLASS_KO, C3)):\n",
+    "    vals = [_results[bs][\"per_class_acc\"].get(cls, 0) * 100 for bs in bs_list]\n",
