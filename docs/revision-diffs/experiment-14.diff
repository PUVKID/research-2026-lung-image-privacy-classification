+    "        x   = BatchNormalization()(x)\n",
+    "        x   = tf.keras.layers.Activation(\"relu\")(x)\n",
+    "        x   = Dropout(0.25)(x)\n",
+    "        out = Dense(NUM_CLASSES, activation=\"softmax\", dtype=\"float32\")(x)\n",
+    "        cloud_model = Model(inputs=cloud_input, outputs=out, name=\"cloud_model\")\n",
+    "    return cloud_model\n",
+    "\n",
+    "\n",
+    "def build_full_pipeline(sigma):\n",
+    "    # 에지 → [FeatureGaussianBlur] → 클라우드를 하나로 연결한 end-to-end 파이프라인.\n",
+    "    # 블러는 고정 커널이지만 미분 가능하므로 역전파는 에지 conv1까지 그대로 전달됩니다.\n",
+    "    edge_model   = build_edge_model()\n",
+    "    feat_h, feat_w, feat_c = edge_model.output_shape[1:]\n",
+    "    cloud_model  = build_cloud_model((feat_h, feat_w, feat_c))\n",
+    "\n",
+    "    edge_model.trainable  = True\n",
+    "    cloud_model.trainable = True\n",
+    "\n",
+    "    img_input   = edge_model.input\n",
+    "    feat_map    = edge_model(img_input, training=True)\n",
+    "    blur_layer  = FeatureGaussianBlur(sigma, feat_h, feat_c, name=\"edge_feature_blur\")\n",
+    "    blurred     = blur_layer(feat_map)\n",
+    "    final_out   = cloud_model(blurred)\n",
+    "\n",
+    "    pipeline = Model(inputs=img_input, outputs=final_out, name=\"edge_cloud_pipeline_stage1_blur\")\n",
+    "    return pipeline, edge_model, cloud_model, blur_layer\n",
+    "\n",
+    "\n",
+    "# ── 구조 검증 ──────────────────────────────────────────────────────────\n",
+    "print(\"=\" * 60)\n",
+    "print(\"🏗️  에지-클라우드 (Stage-1 특징맵 블러 삽입) 모델 정의 완료\")\n",
