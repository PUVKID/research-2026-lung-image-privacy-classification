+LEGEND_FS = 30   # legend font size           -> Regular
+ANNOT_FS  = 26   # in-plot data-value labels  -> Bold
+LW        = 4.2
+MS        = 13
+
+
+def make_figure(labels, privacy, ssim, psnr, x_title, out_path):
