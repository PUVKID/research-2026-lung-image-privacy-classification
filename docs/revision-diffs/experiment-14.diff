+    "    \"\"\"\n",
+    "    if sigma == 0:\n",
+    "        print(f\"  Block{block_size} + Sigma=0: 직전 블록 처리 결과 사용\")\n",
+    "        return source_dir\n",
+    "\n",
+    "    sigma_label = str(sigma).replace(\".\", \"p\")\n",
+    "    out_dir     = os.path.join(PREPROCESSED_DATA_DIR, f\"Block{block_size}_BlurSigma{sigma_label}\")\n",
