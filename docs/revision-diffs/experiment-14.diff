+        "                   if os.path.isdir(os.path.join(directory, d))])\n",
+        "\n",
+        "def list_image_files(directory):\n",
+        "    if not os.path.exists(directory):\n",
+        "        return []\n",
+        "    return sorted([f for f in os.listdir(directory)\n",
+        "                   if f.lower().endswith(IMAGE_EXTENSIONS)])\n",
+        "\n",
