+    "    font_path = next((Path(p) for p in candidates if Path(p).exists()), None)\n",
+    "    if font_path is None:\n",
+    "        for p in fm.findSystemFonts(fontpaths=None, fontext=\"ttf\"):\n",
+    "            low = p.lower()\n",
+    "            if any(name in low for name in [\"nanum\", \"noto\", \"malgun\", \"gulim\"]):\n",
+    "                font_path = Path(p)\n",
