+        "    print(f\"  │  loss gap : {detail.get('loss_gap',0):>+7.4f}{' '*30}│\")\n",
+        "    print(\"  └\" + \"─\" * 54 + \"┘\")\n",
+        "\n",
+        "class AdvancedMonitorCallback(Callback):\n",
+        "    def __init__(self, sigma, fold_idx, every_n_epochs=5, overfit_gap=0.20):\n",
+        "        super().__init__()\n",
+        "        self.sigma = sigma\n",
