+    "ax.set_title(\"클래스별 분류 정확도 비교 (양성·악성·정상)\", fontsize=14, fontweight=\"bold\")\n",
+    "ax.legend(fontsize=10); ax.grid(axis=\"y\"); ax.set_ylim(0, 115)\n",
+    "plt.tight_layout()\n",
+    "savefig(\"blur_02_클래스별정확도.png\")\n",
+    "\n",
+    "# ═══════════════════════════════════════════════════════════════════════════\n",
+    "# 그래프 3: ROC-AUC 꺾은선 + 정확도 이중 y축\n",
