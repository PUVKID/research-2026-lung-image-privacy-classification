+    "class AdvancedMonitorCallback(Callback):\n",
+    "    \"\"\"매 에폭마다 GPU 로깅 + 과적합 조기 경보\"\"\"\n",
+    "    def __init__(self, block_size, fold_idx, every_n_epochs=5, overfit_gap=0.20):\n",
