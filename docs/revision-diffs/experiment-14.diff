+    "                     if f.lower().endswith((\".jpg\",\".jpeg\",\".png\",\".bmp\"))]\n",
+    "        needed = target_count - len(cur_files)\n",
+    "        if needed <= 0:\n",
+    "            print(f\"  {cls}: {len(cur_files)}장 (충분)\"); continue\n",
+    "        print(f\"  {cls}: {len(cur_files)}장 → {target_count}장\")\n",
