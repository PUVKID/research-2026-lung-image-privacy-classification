+    "    ax.set_xlabel(xlabel, fontsize=25, fontweight=\"bold\")\n",
+    "    ax.set_ylabel(ylabel, fontsize=25, fontweight=\"bold\")\n",
+    "    top = ymax if ymax is not None else np.nanmax(values) * 1.18\n",
