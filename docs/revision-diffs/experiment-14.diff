+        "        model.compile(\n",
+        "            optimizer=AdamW(learning_rate=1e-3, weight_decay=1e-4),\n",
+        "            loss=focal_loss(2.0, 0.02),\n",
+        "            metrics=[\"accuracy\"]\n",
