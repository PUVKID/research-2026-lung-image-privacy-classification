+    "            ax_desc.set_ylim(0, 1)\n",
+    "            ax_desc.axis(\"off\")\n",
+    "            ax_desc.text(\n",
+    "                0.5, 0.55,\n",
+    "                stage_desc[st_idx],\n",
+    "                ha=\"center\", va=\"center\",\n",
+    "                fontsize=11, linespacing=1.8,\n",
