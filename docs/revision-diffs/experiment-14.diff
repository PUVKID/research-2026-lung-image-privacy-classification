+      "source": [
+        "# Cell 4: 실험 설정\n",
+        "# 블러 노트북과 동일한 순서/시드/분할 규칙 사용\n",
+        "BLOCK_SIZES  = [512, 256, 128, 64, 32, 16, 8, 4, 2, 1]\n",
+        "\n",
+        "BASE_TRAIN   = \"/workspace/Train\"       # 원본 학습 데이터 (절대 수정하지 않음)\n",
+        "WORKSPACE    = \"/workspace\"\n",
+        "IMG_SIZE     = 512          # 이미지 512×512 고정\n",
+        "BATCH_SIZE   = 8\n",
