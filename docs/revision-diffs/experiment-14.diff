+    "print(f\"✅ 실험 설정 완료 | 블록 {len(BLOCK_SIZES)}개 · 블러 {len(BLUR_SIGMAS)}개 · 조합 {len(BLOCK_SIZES)*len(BLUR_SIGMAS)}개\")"
+   ]
