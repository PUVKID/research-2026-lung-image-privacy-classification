+    "# Cell 12: 전체 실험 루프\n",
+    "import json as json_module\n",
+    "\n",
+    "print(\"\\n\" + \"=\" * 60)\n",
+    "print(\"🔬 블록 암호화 크기별 실험 시작 (ResNet50)\")\n",
+    "print(f\"   블록: {BLOCK_SIZES}\")\n",
+    "print(f\"   K={N_FOLDS} | TTA={TTA_STEPS} | BATCH={BATCH_SIZE} | IMG={IMG_SIZE}\")\n",
+    "print(f\"   클래스별 오버샘플링: {TARGET_COUNT}장\")\n",
+    "print(f\"   실험 버전: {EXPERIMENT_VERSION}\")\n",
+    "print(\"=\" * 60)\n",
+    "gpu_status(\"실험 시작 전\")\n",
+    "\n",
+    "all_results = {}\n",
+    "result_path = os.path.join(WORKSPACE, f\"all_block_results_resnet50_{EXPERIMENT_VERSION}.json\")\n",
+    "\n",
+    "if os.path.exists(result_path):\n",
+    "    with open(result_path) as f:\n",
+    "        saved = json_module.load(f)\n",
+    "    for k, v in saved.items():\n",
+    "        all_results[int(k)] = v\n",
+    "    print(f\"\\n✅ 이전 결과: {sorted(all_results.keys())}\")\n",
+    "\n",
+    "\n",
+    "def _save_feat(block_size, class_names):\n",
+    "    \"\"\"블록별 특징맵 저장 (에지 가중치 자동 탐색)\"\"\"\n",
+    "    import glob as _glob\n",
+    "    label = \"원본\" if block_size >= IMG_SIZE else f\"{block_size} 블록\"\n",
+    "\n",
+    "    # 저장된 에지 가중치 탐색 (여러 경로 시도)\n",
+    "    search_paths = [\n",
+    "        f\"allexp_{block_size}_resnet50_f0_edge.weights.h5\",\n",
+    "        os.path.join(WORKSPACE, f\"allexp_{block_size}_resnet50_f0_edge.weights.h5\"),\n",
+    "        f\"/root/Lung Cancer/allexp_{block_size}_resnet50_f0_edge.weights.h5\",\n",
+    "    ]\n",
+    "    edge_path = None\n",
+    "    for p in search_paths:\n",
+    "        if os.path.exists(p):\n",
+    "            edge_path = p\n",
+    "            break\n",
+    "\n",
+    "    try:\n",
+    "        _vis, _, _ = build_full_pipeline()\n",
+    "        if edge_path:\n",
+    "            _vis.get_layer(\"edge_model\").load_weights(\n",
+    "                edge_path, by_name=True, skip_mismatch=True)\n",
+    "            print(f\"  ✅ 에지 가중치 로드: {edge_path}\")\n",
+    "        else:\n",
+    "            print(f\"  ⚠️  에지 가중치 없음 → ImageNet 초기값으로 시각화\")\n",
+    "\n",
+    "        _split = (ORIGINAL_SPLIT_DIR if block_size >= IMG_SIZE else\n",
+    "                  os.path.join(WORKSPACE,\n",
+    "                               f\"AllExp_Split_Block{block_size}_{EXPERIMENT_VERSION}_seed{SEED}\"))\n",
+    "        _test = os.path.join(_split, \"test\")\n",
+    "        if os.path.exists(_test):\n",
+    "            save_feature_map(_vis, block_size, _test, class_names)\n",
+    "        else:\n",
+    "            print(f\"  ⚠️  테스트 경로 없음: {_test}\")\n",
+    "        del _vis\n",
+    "        tf.keras.backend.clear_session()\n",
+    "        gc.collect()\n",
+    "    except Exception as e:\n",
+    "        print(f\"  ⚠️  특징맵 저장 실패: {e}\")\n",
+    "\n",
+    "\n",
+    "for step_idx, block_size in enumerate(BLOCK_SIZES, start=1):\n",
+    "    if block_size in all_results:\n",
+    "        label = \"원본\" if block_size >= IMG_SIZE else f\"Block{block_size}\"\n",
+    "        print(f\"\\n⏭️  Step {step_idx}/{len(BLOCK_SIZES)} | {label}: \"\n",
+    "              f\"완료({all_results[block_size]['acc']*100:.2f}%) → 스킵\")\n",
+    "\n",
+    "        # 스킵된 블록도 특징맵 없으면 저장 (stage0 파일 기준으로 체크)\n",
+    "        block_folder = feature_map_dir(block_size)\n",
+    "        feat_label   = feature_file_label(block_size)\n",
+    "        feat_exists  = all(\n",
+    "            os.path.exists(os.path.join(block_folder, cls.replace(\" \", \"_\"),\n",
+    "                           f\"stage0_원본_{feat_label}_{cls.replace(' ', '_')}.png\"))\n",
+    "            for cls in all_results[block_size][\"class_names\"]\n",
+    "        )\n",
+    "        if not feat_exists:\n",
+    "            print(f\"  📸 특징맵 없음 → 저장 시도...\")\n",
+    "            _save_feat(block_size, all_results[block_size][\"class_names\"])\n",
+    "        continue\n",
+    "\n",
+    "    print(f\"\\n📦 Step {step_idx}/{len(BLOCK_SIZES)} | Block{block_size} 데이터셋 준비...\")\n",
+    "    block_dir = generate_block_dataset(block_size)\n",
+    "    result    = run_experiment(block_size, block_dir)\n",
+    "    all_results[block_size] = result\n",
+    "\n",
+    "    with open(result_path, \"w\") as f:\n",
+    "        json_module.dump({str(k): v for k, v in all_results.items()}, f,\n",
+    "                         indent=2, ensure_ascii=False)\n",
+    "    print(f\"  💾 중간 저장 완료\")\n",
+    "\n",
+    "    # 학습 완료 후 특징맵 저장\n",
+    "    print(f\"  📸 특징맵 저장 중...\")\n",
+    "    _save_feat(block_size, result[\"class_names\"])\n",
+    "\n",
+    "    gpu_status(f\"Block{block_size} 완료 후\")\n"
