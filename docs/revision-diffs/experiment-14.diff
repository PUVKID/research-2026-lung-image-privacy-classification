+    "        }\n",
+    "\n",
+    "        for st_idx, (sname, lname, sm) in enumerate(stage_models, start=1):\n",
+    "            feat = sm(img_batch, training=False).numpy()[0]\n",
+    "            h, w, c = feat.shape\n",
+    "\n",
