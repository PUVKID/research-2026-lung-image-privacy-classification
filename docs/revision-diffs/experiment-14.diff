+   "source": [
+    "# Cell 12: 전체 실험 루프\n",
+    "import json as json_module\n",
+    "\n",
+    "print(\"\\n\" + \"=\" * 60)\n",
+    "print(\"🔬 블록 암호화 크기별 실험 시작 (ResNet50)\")\n",
+    "print(f\"   블록: {BLOCK_SIZES}\")\n",
+    "print(f\"   K={N_FOLDS} | TTA={TTA_STEPS} | BATCH={BATCH_SIZE} | IMG={IMG_SIZE}\")\n",
+    "print(f\"   클래스별 오버샘플링: {TARGET_COUNT}장\")\n",
+    "print(f\"   실험 버전: {EXPERIMENT_VERSION}\")\n",
+    "print(\"=\" * 60)\n",
+    "gpu_status(\"실험 시작 전\")\n",
+    "\n",
+    "all_results = {}\n",
+    "result_path = os.path.join(WORKSPACE, f\"all_block_results_resnet50_{EXPERIMENT_VERSION}.json\")\n",
+    "\n",
+    "if os.path.exists(result_path):\n",
+    "    with open(result_path) as f:\n",
+    "        saved = json_module.load(f)\n",
+    "    for k, v in saved.items():\n",
+    "        all_results[int(k)] = v\n",
+    "    print(f\"\\n✅ 이전 결과: {sorted(all_results.keys())}\")\n",
+    "\n",
+    "\n",
+    "def _save_feat(block_size, class_names):\n",
+    "    \"\"\"블록별 특징맵 저장 (에지 가중치 자동 탐색)\"\"\"\n",
+    "    import glob as _glob\n",
+    "    label = \"원본\" if block_size >= IMG_SIZE else f\"{block_size} 블록\"\n",
+    "\n",
+    "    # 저장된 에지 가중치 탐색 (여러 경로 시도)\n",
+    "    search_paths = [\n",
+    "        f\"allexp_{block_size}_resnet50_f0_edge.weights.h5\",\n",
+    "        os.path.join(WORKSPACE, f\"allexp_{block_size}_resnet50_f0_edge.weights.h5\"),\n",
+    "        f\"/root/Lung Cancer/allexp_{block_size}_resnet50_f0_edge.weights.h5\",\n",
+    "    ]\n",
+    "    edge_path = None\n",
+    "    for p in search_paths:\n",
+    "        if os.path.exists(p):\n",
+    "            edge_path = p\n",
+    "            break\n",
+    "\n",
+    "    try:\n",
+    "        _vis, _, _ = build_full_pipeline()\n",
+    "        if edge_path:\n",
+    "            _vis.get_layer(\"edge_model\").load_weights(\n",
+    "                edge_path, by_name=True, skip_mismatch=True)\n",
+    "            print(f\"  ✅ 에지 가중치 로드: {edge_path}\")\n",
+    "        else:\n",
+    "            print(f\"  ⚠️  에지 가중치 없음 → ImageNet 초기값으로 시각화\")\n",
+    "\n",
+    "        _split = (ORIGINAL_SPLIT_DIR if block_size >= IMG_SIZE else\n",
+    "                  os.path.join(WORKSPACE,\n",
+    "                               f\"AllExp_Split_Block{block_size}_{EXPERIMENT_VERSION}_seed{SEED}\"))\n",
+    "        _test = os.path.join(_split, \"test\")\n",
+    "        if os.path.exists(_test):\n",
+    "            save_feature_map(_vis, block_size, _test, class_names)\n",
+    "        else:\n",
