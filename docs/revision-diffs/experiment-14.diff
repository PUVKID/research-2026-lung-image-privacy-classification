+    "ax.set_ylim(max(0, min(accs) - 10), min(105, max(accs) + 8))\n",
+    "ax.legend(fontsize=10); ax.grid(axis=\"y\", zorder=0)\n",
+    "plt.tight_layout()\n",
+    "savefig(\"blur_01_전체정확도_막대.png\")\n",
+    "\n",
+    "# ═══════════════════════════════════════════════════════════════════════════\n",
+    "# 그래프 2: 클래스별 정확도 (묶음 막대)\n",
+    "# ═══════════════════════════════════════════════════════════════════════════\n",
+    "print(\"\\n📊 [그래프 2/10] 클래스별 정확도 비교\")\n",
