+    "def _gaussian_kernel_2d(sigma, max_radius):\n",
+    "    # 반환값: (kernel_2d, radius) 또는 완전 붕괴가 필요하면 None.\n",
+    "    radius_wanted = int(math.ceil(3 * sigma))\n",
+    "    if radius_wanted >= max_radius:\n",
+    "        return None\n",
+    "    ax = np.arange(-radius_wanted, radius_wanted + 1, dtype=np.float32)\n",
+    "    kernel_1d = np.exp(-(ax ** 2) / (2 * sigma ** 2))\n",
+    "    kernel_1d /= kernel_1d.sum()\n",
+    "    kernel_2d = np.outer(kernel_1d, kernel_1d)\n",
+    "    kernel_2d /= kernel_2d.sum()\n",
+    "    return kernel_2d.astype(np.float32), radius_wanted\n",
+    "\n",
+    "\n",
+    "class FeatureGaussianBlur(tf.keras.layers.Layer):\n",
+    "    # 에지(Stage-1) 출력 특징맵에 채널별 동일 2D 가우시안 블러를 적용.\n",
+    "    # sigma<=0 이면 항등(identity). sigma가 특징맵 크기에 비해 크면 전역 평균으로 자동 수렴.\n",
+    "    def __init__(self, sigma, feature_size, num_channels, **kwargs):\n",
+    "        super().__init__(**kwargs)\n",
+    "        self.sigma = float(sigma)\n",
+    "        self.feature_size = int(feature_size)\n",
+    "        self.num_channels = int(num_channels)\n",
+    "        self._collapse = False\n",
+    "        self._kernel = None\n",
+    "        self._radius = 0\n",
+    "\n",
+    "        if self.sigma > 0:\n",
+    "            max_radius = (self.feature_size - 1) // 2\n",
+    "            result = _gaussian_kernel_2d(self.sigma, max_radius)\n",
+    "            if result is None:\n",
+    "                self._collapse = True\n",
+    "            else:\n",
+    "                kernel_2d, radius = result\n",
+    "                self._radius = radius\n",
+    "                kernel = np.tile(kernel_2d[:, :, None, None], (1, 1, self.num_channels, 1))\n",
+    "                self._kernel = tf.constant(kernel, dtype=tf.float32)\n",
+    "\n",
+    "    def call(self, x):\n",
+    "        if self.sigma <= 0:\n",
+    "            return x\n",
+    "        x32 = tf.cast(x, tf.float32)\n",
+    "        if self._collapse:\n",
+    "            mean = tf.reduce_mean(x32, axis=[1, 2], keepdims=True)\n",
+    "            out = tf.broadcast_to(mean, tf.shape(x32))\n",
+    "        else:\n",
+    "            x_pad = tf.pad(x32, [[0, 0], [self._radius, self._radius],\n",
+    "                                  [self._radius, self._radius], [0, 0]], mode=\"REFLECT\")\n",
+    "            out = tf.nn.depthwise_conv2d(x_pad, self._kernel, strides=[1, 1, 1, 1], padding=\"VALID\")\n",
+    "        return tf.cast(out, x.dtype)\n",
+    "\n",
+    "    def get_config(self):\n",
+    "        config = super().get_config()\n",
+    "        config.update({\"sigma\": self.sigma, \"feature_size\": self.feature_size,\n",
+    "                        \"num_channels\": self.num_channels})\n",
+    "        return config\n",
+    "\n",
+    "\n",
+    "def is_collapse_sigma(sigma, feature_size=128):\n",
+    "    # 이 σ가 FeatureGaussianBlur에서 \"완전 붕괴(전역 평균)\" 분기를 타는지 미리 판단.\n",
+    "    # 커널 반경이 특징맵 크기의 절반을 넘어서면 실제로 계산되는 결과가 항상 똑같은\n",
+    "    # 전역 평균이 되므로, 학습 루프에서 중복 학습을 건너뛸지 판단하는 데 사용합니다.\n",
+    "    if sigma <= 0:\n",
+    "        return False\n",
+    "    max_radius = (feature_size - 1) // 2\n",
+    "    radius_wanted = int(math.ceil(3 * sigma))\n",
+    "    return radius_wanted >= max_radius\n",
+    "\n",
+    "\n",
+    "EDGE_OUTPUT_LAYER = \"pool1_pool\"\n",
+    "\n",
+    "def build_edge_model():\n",
+    "    _gpus = tf.config.list_physical_devices(\"GPU\")\n",
+    "    _device = \"/GPU:0\" if _gpus else \"/CPU:0\"\n",
