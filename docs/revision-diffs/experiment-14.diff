+    "security    = [100-(c/(IMG_SIZE[0]*IMG_SIZE[1]*3)*100) for c in compressed]\n",
+    "x_pos       = np.arange(len(POOL_SIZES))\n",
+    "cmap_rg     = plt.cm.RdYlGn(np.linspace(0.15, 0.95, len(POOL_SIZES)))\n",
