+    "               validation_steps=math.ceil(p_vn / BATCH_SIZE),\n",
+    "               epochs=15,\n",
+    "               callbacks=[\n",
+    "                   EarlyStopping(monitor=\"val_loss\", patience=12, min_delta=1e-4,\n",
+    "                                 restore_best_weights=True, verbose=0),\n",
