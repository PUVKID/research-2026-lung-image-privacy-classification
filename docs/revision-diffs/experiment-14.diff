+        "fig, ax = plt.subplots(figsize=(22, 11))\n",
+        "bars = ax.bar(labels, accs, color=BAR_COLORS, width=0.6, zorder=3)\n",
+        "\n",
+        "for bar, val in zip(bars, accs):\n",
