+   "cell_type": "code",
+   "execution_count": null,
+   "metadata": {},
+   "outputs": [],
+   "source": [
+    "def _gaussian_kernel_2d(sigma, max_radius):\n",
+    "    # 반환값: (kernel_2d, radius) 또는 완전 붕괴가 필요하면 None.\n",
+    "    radius_wanted = int(math.ceil(3 * sigma))\n",
+    "    if radius_wanted >= max_radius:\n",
+    "        return None\n",
+    "    ax = np.arange(-radius_wanted, radius_wanted + 1, dtype=np.float32)\n",
+    "    kernel_1d = np.exp(-(ax ** 2) / (2 * sigma ** 2))\n",
+    "    kernel_1d /= kernel_1d.sum()\n",
+    "    kernel_2d = np.outer(kernel_1d, kernel_1d)\n",
+    "    kernel_2d /= kernel_2d.sum()\n",
+    "    return kernel_2d.astype(np.float32), radius_wanted\n",
+    "\n",
+    "\n",
+    "class FeatureGaussianBlur(tf.keras.layers.Layer):\n",
+    "    # 에지(Stage-1) 출력 특징맵에 채널별 동일 2D 가우시안 블러를 적용.\n",
+    "    # sigma<=0 이면 항등(identity). sigma가 특징맵 크기에 비해 크면 전역 평균으로 자동 수렴.\n",
+    "    def __init__(self, sigma, feature_size, num_channels, **kwargs):\n",
+    "        super().__init__(**kwargs)\n",
+    "        self.sigma = float(sigma)\n",
+    "        self.feature_size = int(feature_size)\n",
+    "        self.num_channels = int(num_channels)\n",
+    "        self._collapse = False\n",
+    "        self._kernel = None\n",
+    "        self._radius = 0\n",
+    "\n",
+    "        if self.sigma > 0:\n",
+    "            max_radius = (self.feature_size - 1) // 2\n",
+    "            result = _gaussian_kernel_2d(self.sigma, max_radius)\n",
+    "            if result is None:\n",
+    "                self._collapse = True\n",
+    "            else:\n",
+    "                kernel_2d, radius = result\n",
+    "                self._radius = radius\n",
+    "                kernel = np.tile(kernel_2d[:, :, None, None], (1, 1, self.num_channels, 1))\n",
+    "                self._kernel = tf.constant(kernel, dtype=tf.float32)\n",
+    "\n",
+    "    def call(self, x):\n",
+    "        if self.sigma <= 0:\n",
+    "            return x\n",
+    "        x32 = tf.cast(x, tf.float32)\n",
+    "        if self._collapse:\n",
+    "            mean = tf.reduce_mean(x32, axis=[1, 2], keepdims=True)\n",
+    "            out = tf.broadcast_to(mean, tf.shape(x32))\n",
+    "        else:\n",
+    "            x_pad = tf.pad(x32, [[0, 0], [self._radius, self._radius],\n",
+    "                                  [self._radius, self._radius], [0, 0]], mode=\"REFLECT\")\n",
+    "            out = tf.nn.depthwise_conv2d(x_pad, self._kernel, strides=[1, 1, 1, 1], padding=\"VALID\")\n",
+    "        return tf.cast(out, x.dtype)\n",
+    "\n",
+    "    def get_config(self):\n",
+    "        config = super().get_config()\n",
+    "        config.update({\"sigma\": self.sigma, \"feature_size\": self.feature_size,\n",
+    "                        \"num_channels\": self.num_channels})\n",
+    "        return config\n",
+    "\n",
+    "\n",
+    "def is_collapse_sigma(sigma, feature_size=128):\n",
+    "    # 이 σ가 FeatureGaussianBlur에서 \"완전 붕괴(전역 평균)\" 분기를 타는지 미리 판단.\n",
+    "    # 커널 반경이 특징맵 크기의 절반을 넘어서면 실제로 계산되는 결과가 항상 똑같은\n",
+    "    # 전역 평균이 되므로, 학습 루프에서 중복 학습을 건너뛸지 판단하는 데 사용합니다.\n",
+    "    if sigma <= 0:\n",
+    "        return False\n",
+    "    max_radius = (feature_size - 1) // 2\n",
+    "    radius_wanted = int(math.ceil(3 * sigma))\n",
+    "    return radius_wanted >= max_radius\n",
+    "\n",
+    "\n",
+    "EDGE_OUTPUT_LAYER = \"pool1_pool\"\n",
+    "\n",
+    "def build_edge_model():\n",
+    "    _gpus = tf.config.list_physical_devices(\"GPU\")\n",
+    "    _device = \"/GPU:0\" if _gpus else \"/CPU:0\"\n",
+    "    with tf.device(_device):\n",
+    "        full_base   = ResNet50(weights=\"imagenet\", include_top=False,\n",
+    "                               input_shape=(IMG_SIZE, IMG_SIZE, 3))\n",
+    "        edge_output = full_base.get_layer(EDGE_OUTPUT_LAYER).output\n",
+    "        edge_model  = Model(inputs=full_base.input, outputs=edge_output, name=\"edge_model\")\n",
+    "    return edge_model\n",
+    "\n",
+    "\n",
+    "def build_cloud_model(edge_output_shape):\n",
+    "    _gpus = tf.config.list_physical_devices(\"GPU\")\n",
+    "    _device = \"/GPU:0\" if _gpus else \"/CPU:0\"\n",
+    "    with tf.device(_device):\n",
+    "        full_base  = ResNet50(weights=\"imagenet\", include_top=False,\n",
+    "                              input_shape=(IMG_SIZE, IMG_SIZE, 3))\n",
+    "        stage1_end = full_base.get_layer(EDGE_OUTPUT_LAYER)\n",
+    "        cloud_base = Model(inputs=stage1_end.output, outputs=full_base.output, name=\"cloud_base\")\n",
+    "\n",
+    "        cloud_input = tf.keras.Input(shape=edge_output_shape, name=\"cloud_input\")\n",
+    "        x = cloud_base(cloud_input)\n",
+    "        gap = GlobalAveragePooling2D()(x)\n",
+    "        gmp = GlobalMaxPooling2D()(x)\n",
+    "        x   = Concatenate()([gap, gmp])\n",
+    "        x   = Dense(512, kernel_regularizer=l2(1e-4))(x)\n",
+    "        x   = BatchNormalization()(x)\n",
+    "        x   = tf.keras.layers.Activation(\"relu\")(x)\n",
+    "        x   = Dropout(0.35)(x)\n",
+    "        x   = Dense(256, kernel_regularizer=l2(1e-4))(x)\n",
+    "        x   = BatchNormalization()(x)\n",
+    "        x   = tf.keras.layers.Activation(\"relu\")(x)\n",
+    "        x   = Dropout(0.25)(x)\n",
+    "        out = Dense(NUM_CLASSES, activation=\"softmax\", dtype=\"float32\")(x)\n",
+    "        cloud_model = Model(inputs=cloud_input, outputs=out, name=\"cloud_model\")\n",
+    "    return cloud_model\n",
+    "\n",
+    "\n",
+    "def build_full_pipeline(sigma):\n",
+    "    # 에지 → [FeatureGaussianBlur] → 클라우드를 하나로 연결한 end-to-end 파이프라인.\n",
+    "    # 블러는 고정 커널이지만 미분 가능하므로 역전파는 에지 conv1까지 그대로 전달됩니다.\n",
+    "    edge_model   = build_edge_model()\n",
+    "    feat_h, feat_w, feat_c = edge_model.output_shape[1:]\n",
+    "    cloud_model  = build_cloud_model((feat_h, feat_w, feat_c))\n",
+    "\n",
+    "    edge_model.trainable  = True\n",
+    "    cloud_model.trainable = True\n",
+    "\n",
+    "    img_input   = edge_model.input\n",
+    "    feat_map    = edge_model(img_input, training=True)\n",
+    "    blur_layer  = FeatureGaussianBlur(sigma, feat_h, feat_c, name=\"edge_feature_blur\")\n",
+    "    blurred     = blur_layer(feat_map)\n",
+    "    final_out   = cloud_model(blurred)\n",
+    "\n",
+    "    pipeline = Model(inputs=img_input, outputs=final_out, name=\"edge_cloud_pipeline_stage1_blur\")\n",
+    "    return pipeline, edge_model, cloud_model, blur_layer\n",
+    "\n",
+    "\n",
+    "# ── 구조 검증 ──────────────────────────────────────────────────────────\n",
+    "print(\"=\" * 60)\n",
+    "print(\"🏗️  에지-클라우드 (Stage-1 특징맵 블러 삽입) 모델 정의 완료\")\n",
+    "print(\"=\" * 60)\n",
+    "_tmp_pipeline, _tmp_edge, _tmp_cloud, _tmp_blur = build_full_pipeline(sigma=8)\n",
+    "print(f\"  [Edge  Model] 입력: ({IMG_SIZE}, {IMG_SIZE}, 3)  출력: {_tmp_edge.output_shape[1:]}\")\n",
+    "print(f\"  [Blur Layer ] σ=8 예시 → collapse={_tmp_blur._collapse}, radius={_tmp_blur._radius}\")\n",
+    "print(f\"  [Cloud Model] 입력: {_tmp_edge.output_shape[1:]}  출력: ({NUM_CLASSES},)\")\n",
+    "del _tmp_pipeline, _tmp_edge, _tmp_cloud, _tmp_blur\n",
+    "tf.keras.backend.clear_session()\n",
+    "for _s in FEATURE_BLUR_SIGMAS:\n",
+    "    if _s == 0:\n",
+    "        _tag = \"항등(블러 없음)\"\n",
+    "    elif is_collapse_sigma(_s):\n",
+    "        _tag = \"collapse(전역 평균)\"\n",
+    "    else:\n",
+    "        _tag = f\"kernel radius={int(math.ceil(3 * _s))}\"\n",
+    "    print(f\"    σ={_s:>3} → {_tag}\")\n"
