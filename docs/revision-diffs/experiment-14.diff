+    "        ax.imshow(img_raw.numpy())\n",
+    "        ax.set_title(f\"[{label}] {cls}\\n원본 CT 이미지 ({IMG_SIZE}×{IMG_SIZE}×3)\",\n",
+    "                     fontsize=11, fontweight=\"bold\")\n",
+    "        ax.axis(\"off\")\n",
+    "        fig.tight_layout()\n",
+    "        p = os.path.join(cls_folder,\n",
