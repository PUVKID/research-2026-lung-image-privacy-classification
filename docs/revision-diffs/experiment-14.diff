+    "\n",
+    "# =============================================================\n",
+    "# 실험 설정\n",
+    "# =============================================================\n",
+    "BASE_DIR     = \"/workspace/Lung Cancer/Train\"\n",
+    "TARGET_COUNT = 1000\n",
+    "\n",
+    "# ★ 512×512로 업그레이드! (원본 데이터 크기와 동일)\n",
+    "# MobileNetV2에 512 넣으면 특징맵이 16×16이 됨\n",
+    "# → 풀링 실험이 1×1 ~ 16×16으로 더 다양해짐!\n",
+    "IMG_SIZE     = (512, 512)\n",
+    "\n",
+    "# BATCH_SIZE: 512×512는 메모리 많이 씀\n",
