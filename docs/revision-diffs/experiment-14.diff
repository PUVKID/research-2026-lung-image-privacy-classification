+    "                      if os.path.isdir(os.path.join(BASE_TRAIN, d))])\n",
+    "    total_src = sum(len([f for f in os.listdir(os.path.join(BASE_TRAIN,c))\n",
+    "                         if f.lower().endswith((\".jpg\",\".jpeg\",\".png\",\".bmp\"))])\n",
+    "                    for c in classes)\n",
