+    "        cx, cy = cutmix_batch(x, y, alpha)\n",
+    "        return tf.cond(use_cutmix, lambda: (cx, cy), lambda: (mx, my))\n",
+    "    return _deterministic(ds.map(_apply, num_parallel_calls=AUTOTUNE)).prefetch(1)\n",
+    "\n",
