+    "def _gaussian_kernel_2d(sigma, max_radius):\n",
+    "    # 반환값: (kernel_2d, radius) 또는 완전 붕괴가 필요하면 None.\n",
+    "    radius_wanted = int(math.ceil(3 * sigma))\n",
+    "    if radius_wanted >= max_radius:\n",
+    "        return None\n",
+    "    ax = np.arange(-radius_wanted, radius_wanted + 1, dtype=np.float32)\n",
+    "    kernel_1d = np.exp(-(ax ** 2) / (2 * sigma ** 2))\n",
+    "    kernel_1d /= kernel_1d.sum()\n",
+    "    kernel_2d = np.outer(kernel_1d, kernel_1d)\n",
+    "    kernel_2d /= kernel_2d.sum()\n",
+    "    return kernel_2d.astype(np.float32), radius_wanted\n",
+    "\n",
+    "\n",
+    "class FeatureGaussianBlur(tf.keras.layers.Layer):\n",
