+    "    ds = ds.batch(batch_size, drop_remainder=False).prefetch(1)\n",
+    "    return ds, n, paths\n",
+    "\n",
+    "def make_tta_ds(directory, class_names, batch_size=BATCH_SIZE):\n",
+    "    paths, labels = get_paths_labels(directory, class_names)\n",
+    "    n  = len(paths)\n",
