+    "    # (1) Feature Privacy Score: DSSIM(블러전, 블러후) 같은 이미지 기준\n",
+    "    # (2) 클래스 내/외 코사인 유사도(GAP 벡터 기준)\n",
+    "    # 를 계산해 반환합니다.\n",
+    "    edge_model = build_edge_model()\n",
+    "    if edge_weights_path and os.path.exists(edge_weights_path):\n",
+    "        edge_model.load_weights(edge_weights_path, by_name=True, skip_mismatch=True)\n",
+    "    feat_h, feat_w, feat_c = edge_model.output_shape[1:]\n",
+    "    blur_layer = FeatureGaussianBlur(sigma, feat_h, feat_c, name=\"privacy_probe_blur\")\n",
+    "\n",
+    "    rng = random.Random(seed)\n",
+    "    gap_vectors, gap_labels, dssim_vals = [], [], []\n",
+    "\n",
+    "    for cls in class_names:\n",
+    "        files = list_image_files(os.path.join(test_dir, cls))\n",
+    "        rng.shuffle(files)\n",
+    "        for f in files[:n_per_class]:\n",
+    "            img = tf.io.read_file(os.path.join(test_dir, cls, f))\n",
+    "            img = tf.image.decode_image(img, channels=3, expand_animations=False)\n",
+    "            img = tf.image.resize(img, [IMG_SIZE, IMG_SIZE])\n",
+    "            img = tf.cast(img, tf.float32)\n",
+    "            feat_raw = edge_model(tf.expand_dims(img, 0), training=False)\n",
+    "            feat_blur = blur_layer(feat_raw)\n",
+    "\n",
+    "            if sigma > 0:\n",
+    "                raw_map  = _minmax_norm(tf.reduce_mean(feat_raw[0], axis=-1))\n",
+    "                blur_map = _minmax_norm(tf.reduce_mean(feat_blur[0], axis=-1))\n",
+    "                ssim_val = tf.image.ssim(raw_map[None, ..., None], blur_map[None, ..., None], max_val=1.0).numpy()[0]\n",
+    "                dssim_vals.append((1.0 - float(ssim_val)) / 2.0 * 100.0)\n",
+    "            else:\n",
+    "                dssim_vals.append(0.0)\n",
+    "\n",
+    "            gap_vec = tf.reduce_mean(feat_blur[0], axis=[0, 1]).numpy()\n",
+    "            gap_vectors.append(gap_vec / (np.linalg.norm(gap_vec) + 1e-8))\n",
+    "            gap_labels.append(cls)\n",
+    "\n",
+    "    gap_vectors = np.array(gap_vectors)\n",
+    "    gap_labels  = np.array(gap_labels)\n",
+    "    sims = gap_vectors @ gap_vectors.T\n",
+    "\n",
+    "    intra_vals, inter_vals = [], []\n",
+    "    n = len(gap_labels)\n",
+    "    for i in range(n):\n",
+    "        for j in range(i + 1, n):\n",
+    "            if gap_labels[i] == gap_labels[j]:\n",
+    "                intra_vals.append(sims[i, j])\n",
+    "            else:\n",
+    "                inter_vals.append(sims[i, j])\n",
