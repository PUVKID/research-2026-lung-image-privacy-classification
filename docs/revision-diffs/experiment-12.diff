+    "def build_reconstruction_decoder(feat_shape):\n",
+    "    inp = tf.keras.Input(shape=feat_shape)\n",
+    "    x = Conv2D(128, 3, padding=\"same\", activation=\"relu\")(inp)\n",
+    "    x = tf.keras.layers.Conv2DTranspose(64, 4, strides=2, padding=\"same\", activation=\"relu\")(x)   # 128→256\n",
+    "    x = Conv2D(64, 3, padding=\"same\", activation=\"relu\")(x)\n",
+    "    x = tf.keras.layers.Conv2DTranspose(32, 4, strides=2, padding=\"same\", activation=\"relu\")(x)   # 256→512\n",
+    "    x = Conv2D(16, 3, padding=\"same\", activation=\"relu\")(x)\n",
+    "    out = Conv2D(3, 3, padding=\"same\", activation=\"sigmoid\", dtype=\"float32\")(x)\n",
+    "    return Model(inp, out, name=\"recon_decoder\")\n",
+    "\n",
+    "\n",
+    "def _extract_features_and_targets(directory, edge_model, blur_layer, class_names,\n",
+    "                                   max_samples=None, seed=SEED, batch_size=BATCH_SIZE):\n",
+    "    paths, _ = get_paths_labels(directory, class_names)\n",
+    "    if max_samples is not None and len(paths) > max_samples:\n",
+    "        rng = random.Random(seed)\n",
+    "        paths = rng.sample(paths, max_samples)\n",
+    "\n",
+    "    feats, targets = [], []\n",
+    "    for i in range(0, len(paths), batch_size):\n",
+    "        batch_paths = paths[i:i + batch_size]\n",
+    "        imgs = []\n",
+    "        for p in batch_paths:\n",
+    "            img = tf.io.read_file(p)\n",
+    "            img = tf.image.decode_image(img, channels=3, expand_animations=False)\n",
+    "            img = tf.image.resize(img, [IMG_SIZE, IMG_SIZE])\n",
+    "            imgs.append(tf.cast(img, tf.float32))\n",
+    "        imgs = tf.stack(imgs, axis=0)\n",
+    "        feat = edge_model(imgs, training=False)\n",
+    "        feat = blur_layer(feat)\n",
+    "        feats.append(feat.numpy())\n",
+    "        targets.append((imgs.numpy() / 255.0).astype(np.float32))\n",
+    "    return np.concatenate(feats, axis=0), np.concatenate(targets, axis=0)\n",
+    "\n",
+    "\n",
+    "def run_reconstruction_attack(edge_weights_path, sigma, train_dir, val_dir, test_dir, class_names,\n",
+    "                               model_stem, epochs=25, max_train=400, max_val=80, max_test=120, seed=SEED):\n",
+    "    edge_model = build_edge_model()\n",
+    "    if edge_weights_path and os.path.exists(edge_weights_path):\n",
+    "        edge_model.load_weights(edge_weights_path, by_name=True, skip_mismatch=True)\n",
+    "    edge_model.trainable = False\n",
+    "    feat_h, feat_w, feat_c = edge_model.output_shape[1:]\n",
+    "    blur_layer = FeatureGaussianBlur(sigma, feat_h, feat_c, name=\"recon_probe_blur\")\n",
+    "\n",
+    "    X_train, Y_train = _extract_features_and_targets(train_dir, edge_model, blur_layer, class_names, max_train, seed)\n",
+    "    X_val,   Y_val   = _extract_features_and_targets(val_dir,   edge_model, blur_layer, class_names, max_val, seed + 1)\n",
+    "    X_test,  Y_test  = _extract_features_and_targets(test_dir,  edge_model, blur_layer, class_names, max_test, seed + 2)\n",
+    "\n",
+    "    decoder = build_reconstruction_decoder((feat_h, feat_w, feat_c))\n",
+    "    decoder.compile(optimizer=AdamW(learning_rate=5e-4, weight_decay=1e-5), loss=\"mae\")\n",
+    "    decoder.fit(\n",
+    "        X_train, Y_train, validation_data=(X_val, Y_val),\n",
+    "        epochs=epochs, batch_size=BATCH_SIZE, verbose=0,\n",
+    "        callbacks=[\n",
+    "            EarlyStopping(monitor=\"val_loss\", patience=6, min_delta=1e-4, restore_best_weights=True, verbose=0),\n",
+    "            TerminateOnNaN(),\n",
+    "        ]\n",
+    "    )\n",
+    "\n",
+    "    recon = decoder.predict(X_test, batch_size=BATCH_SIZE, verbose=0)\n",
+    "    psnr_vals = tf.image.psnr(Y_test, recon, max_val=1.0).numpy()\n",
+    "    ssim_vals = tf.image.ssim(Y_test, recon, max_val=1.0).numpy()\n",
+    "\n",
+    "    decoder_path = os.path.join(DECODER_MODEL_DIR, f\"{model_stem}_decoder.weights.h5\")\n",
+    "    decoder.save_weights(decoder_path)\n",
+    "\n",
+    "    del edge_model, decoder\n",
+    "    tf.keras.backend.clear_session(); gc.collect()\n",
+    "\n",
+    "    return {\n",
+    "        \"reconstruction_psnr\": float(np.mean(psnr_vals)),\n",
+    "        \"reconstruction_ssim\": float(np.mean(ssim_vals)),\n",
+    "        \"recon_decoder_path\": decoder_path,\n",
+    "        \"n_train\": int(len(X_train)), \"n_test\": int(len(X_test)),\n",
+    "    }\n",
+    "\n",
+    "print(\"✅ build_reconstruction_decoder / run_reconstruction_attack 정의 완료\")\n"
