+        "    va = float(val_acc[-1]) if len(val_acc) else 0.0\n",
+        "\n",
+        "    acc_gap  = ta - va\n",
+        "    loss_gap = vl - tl\n",
+        "\n",
+        "    if acc_gap > 0.18 and loss_gap > 0.20:\n",
+        "        status = \"overfit\"\n",
+        "    elif ta < 0.65 and va < 0.65:\n",
