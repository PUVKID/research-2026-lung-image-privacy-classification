+        "EXPERIMENT_VERSION = \"unified_v1\"\n",
+        "ORIGINAL_SPLIT_DIR = os.path.join(\n",
+        "    WORKSPACE, f\"AllExp_Split_ORIGINAL_seed{SEED}_{EXPERIMENT_VERSION}\"\n",
+        ")\n",
+        "IMAGE_EXTENSIONS = (\".jpg\", \".jpeg\", \".png\", \".bmp\")\n",
