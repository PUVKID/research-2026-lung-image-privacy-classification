+    "            va=\"bottom\",\n",
+    "            fontsize=value_fontsize,\n",
+    "            fontweight=\"bold\",\n",
+    "            color=\"#1a1a1a\"\n",
+    "        )\n",
+    "\n",
+    "    # 기준선\n",
+    "    handles, labels_leg = [], []\n",
+    "\n",
+    "    if show_max:\n",
+    "        mx = np.nanmax(values)\n",
+    "        h = ax.axhline(\n",
+    "            mx,\n",
+    "            color=\"#e05a5a\",\n",
+    "            linestyle=\"--\",\n",
+    "            linewidth=1.4,\n",
+    "            zorder=2\n",
+    "        )\n",
+    "        handles.append(h)\n",
