+   "source": [
+    "from PIL import Image, ImageDraw, ImageFont\n",
+    "import os\n",
+    "\n",
+    "# =========================================================\n",
+    "# 1. 경로 설정\n",
+    "# =========================================================\n",
+    "\n",
+    "image_paths = [\n",
+    "    r\".\\Train\\Bengin cases\\Bengin case (1).jpg\",\n",
+    "    r\".\\2026\\폐암 논문\\블록 + 블러\\실험 완료\\256\\Train_Block256\\Bengin cases\\Bengin case (1).jpg\",\n",
+    "    r\".\\2026\\폐암 논문\\블록 + 블러\\실험 완료\\512\\Train_Block512_BlurSigma256\\Bengin cases\\Bengin case (1).jpg\",\n",
+    "    r\".\\2026\\폐암 논문\\블록 + 블러\\실험 완료\\256\\Train_Block256_BlurSigma32\\Bengin cases\\Bengin case (1).jpg\",\n",
+    "]\n",
+    "\n",
+    "labels = [\n",
+    "    \"(a) Original\",\n",
+    "    \"(b) B256_S0\",\n",
+    "    \"(c) B512_S256\",\n",
+    "    \"(d) B256_S32\"\n",
+    "]\n",
+    "\n",
+    "# =========================================================\n",
+    "# 2. 폰트 설정\n",
+    "# =========================================================\n",
+    "\n",
+    "font_path = (\n",
+    "    r\"fonts\"\n",
+    "    r\"\\NanumGothicBold.ttf\"\n",
+    ")\n",
+    "\n",
+    "font_size = 45\n",
+    "\n",
+    "# 라벨이 들어갈 하단 여백\n",
+    "label_area_h = 60\n",
+    "\n",
+    "# 이미지 사이 여백\n",
+    "gap = 4\n",
+    "\n",
+    "# =========================================================\n",
+    "# 3. 경로 및 폰트 확인\n",
+    "# =========================================================\n",
+    "\n",
+    "for path in image_paths:\n",
+    "    if not os.path.exists(path):\n",
+    "        raise FileNotFoundError(\n",
+    "            f\"이미지를 찾을 수 없습니다:\\n{path}\"\n",
+    "        )\n",
+    "\n",
+    "if not os.path.exists(font_path):\n",
+    "    raise FileNotFoundError(\n",
+    "        f\"폰트를 찾을 수 없습니다:\\n{font_path}\"\n",
+    "    )\n",
+    "\n",
+    "# NanumGothic Bold 25pt\n",
+    "font = ImageFont.truetype(\n",
+    "    font_path,\n",
+    "    font_size\n",
+    ")\n",
+    "\n",
+    "print(\"NanumGothic Bold 25pt 로드 완료\")\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 4. 이미지 불러오기\n",
+    "# =========================================================\n",
+    "\n",
+    "imgs = [\n",
+    "    Image.open(path).convert(\"RGB\")\n",
+    "    for path in image_paths\n",
+    "]\n",
+    "\n",
+    "# 첫 번째 이미지 크기를 기준으로 통일\n",
+    "target_size = imgs[0].size\n",
+    "\n",
+    "imgs = [\n",
+    "    img.resize(target_size)\n",
+    "    for img in imgs\n",
+    "]\n",
+    "\n",
+    "w, h = target_size\n",
+    "\n",
+    "print(f\"기준 이미지 크기: {w} x {h}\")\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 5. 이미지 + 라벨 합치기\n",
+    "# =========================================================\n",
+    "\n",
+    "def add_label(img, text):\n",
+    "\n",
+    "    # 이미지 아래에 라벨 영역 추가\n",
+    "    canvas = Image.new(\n",
+    "        \"RGB\",\n",
+    "        (w, h + label_area_h),\n",
+    "        \"white\"\n",
+    "    )\n",
+    "\n",
+    "    # 원본 이미지 붙이기\n",
+    "    canvas.paste(\n",
+    "        img,\n",
+    "        (0, 0)\n",
+    "    )\n",
+    "\n",
+    "    draw = ImageDraw.Draw(canvas)\n",
+    "\n",
+    "    # 글자 크기 측정\n",
+    "    bbox = draw.textbbox(\n",
+    "        (0, 0),\n",
+    "        text,\n",
+    "        font=font\n",
+    "    )\n",
+    "\n",
+    "    text_w = bbox[2] - bbox[0]\n",
+    "    text_h = bbox[3] - bbox[1]\n",
+    "\n",
+    "    # 가운데 정렬\n",
+    "    x = (w - text_w) // 2\n",
+    "\n",
+    "    # 라벨 영역 중앙 정렬\n",
+    "    y = (\n",
+    "        h\n",
+    "        + (label_area_h - text_h) // 2\n",
+    "        - bbox[1]\n",
+    "    )\n",
+    "\n",
+    "    # 검정색 Bold 글자\n",
+    "    draw.text(\n",
+    "        (x, y),\n",
+    "        text,\n",
+    "        font=font,\n",
+    "        fill=\"black\"\n",
+    "    )\n",
+    "\n",
+    "    return canvas\n",
+    "\n",
+    "\n",
+    "panels = [\n",
+    "    add_label(img, label)\n",
+    "    for img, label in zip(imgs, labels)\n",
+    "]\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 6. 2 x 2 합성\n",
+    "# =========================================================\n",
+    "\n",
+    "cell_w = w + gap\n",
+    "cell_h = (h + label_area_h) + gap\n",
+    "\n",
+    "grid_w = cell_w * 2 - gap\n",
+    "grid_h = cell_h * 2 - gap\n",
+    "\n",
+    "grid = Image.new(\n",
+    "    \"RGB\",\n",
+    "    (grid_w, grid_h),\n",
+    "    \"white\"\n",
+    ")\n",
+    "\n",
+    "positions = [\n",
+    "    (0, 0),\n",
+    "    (cell_w, 0),\n",
+    "    (0, cell_h),\n",
+    "    (cell_w, cell_h)\n",
+    "]\n",
+    "\n",
+    "for panel, pos in zip(\n",
+    "    panels,\n",
+    "    positions\n",
+    "):\n",
+    "    grid.paste(\n",
+    "        panel,\n",
+    "        pos\n",
+    "    )\n",
+    "\n",
+    "\n",
+    "# =========================================================\n",
+    "# 7. 결과 저장\n",
+    "# =========================================================\n",
+    "\n",
+    "output_path = (\n",
+    "    r\".\\2026\\폐암 논문\"\n",
+    "    r\"\\블록 + 블러\\실험 완료\"\n",
+    "    r\"\\privacy_composite_2x2.png\"\n",
