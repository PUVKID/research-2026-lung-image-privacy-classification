+    "                    })\n",
+    "                    used_pct = int(parts[0]) / int(parts[1]) * 100\n",
+    "                    if used_pct > 90:\n",
+    "                        print(f\"\\n  ⚠️  VRAM {used_pct:.1f}% — OOM 위험!\")\n",
+    "            except:\n",
+    "                pass\n",
+    "\n",
+    "        tr_loss = logs.get(\"loss\")\n",
+    "        va_loss = logs.get(\"val_loss\")\n",
+    "        tr_acc  = logs.get(\"accuracy\")\n",
