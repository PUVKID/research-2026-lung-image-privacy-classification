+        "\n",
+        "        train_acc  = logs.get(\"accuracy\")\n",
+        "        val_acc    = logs.get(\"val_accuracy\")\n",
+        "        train_loss = logs.get(\"loss\")\n",
+        "        val_loss   = logs.get(\"val_loss\")\n",
