+        "class OverfitControlCallback(Callback):\n",
+        "    \"\"\"과적합이 여러 에폭 연속 지속되면 현재 학습 단계를 조기 종료한다.\"\"\"\n",
+        "    def __init__(self, min_epochs=20, patience=8, acc_gap=0.18, loss_gap=0.20):\n",
+        "        super().__init__()\n",
+        "        self.min_epochs = min_epochs\n",
+        "        self.patience   = patience\n",
