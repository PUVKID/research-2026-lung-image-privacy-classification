+        "            print(f\"\\n  🛑 과적합 방지: {self.bad_count}회 연속 과적합 신호 → 현재 학습 단계 종료\")\n",
+        "            self.model.stop_training = True\n",
+        "\n",
+        "print(\"✅ diagnose_fit / print_fold_result / AdvancedMonitorCallback 정의 완료\")\n"
+      ]
