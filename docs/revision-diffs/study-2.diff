+        "    block_label = \"원본\" if block_size >= IMG_SIZE else f\"B{block_size}\"\n",
+        "    blur_label  = \"원본\" if sigma == 0 else f\"σ{sigma}\"\n",
+        "    return f\"{block_label}·{blur_label}\"\n",
+        "\n",
