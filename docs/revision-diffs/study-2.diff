+        "\n",
+        "    print(f\"  확신도 88%+ 샘플: {pseudo_cnt}장\")\n",
+        "\n",
+        "    if pseudo_cnt >= 10:\n",
+        "        pk = os.path.join(split_dir, \"pseudo_kfold\")\n",
+        "        if os.path.exists(pk):\n",
+        "            shutil.rmtree(pk)\n",
+        "\n",
+        "        for cls in class_names:\n",
