+        "            smi = subprocess.run(\n",
+        "                [\"nvidia-smi\", \"--query-gpu=memory.used,memory.total,utilization.gpu,temperature.gpu\",\n",
+        "                 \"--format=csv,noheader,nounits\"],\n",
