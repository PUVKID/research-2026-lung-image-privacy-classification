+        "# 01. 블록 픽셀 크기별 Privacy Score + SSIM + PSNR 참고 (Original을 맨 왼쪽에 표시)\n",
+        "block_labels = [\"Original\"] + block_df[\"block_size\"].astype(int).astype(str).tolist()\n",
+        "block_scores = [0.0] + block_df[\"privacy_score\"].tolist()\n",
