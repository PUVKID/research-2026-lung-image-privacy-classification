+        "fig, ax = plt.subplots(figsize=(13, 5))\n",
+        "bars = ax.bar(labels, accs, color=COLORS, edgecolor=\"#555\", linewidth=0.8, zorder=3)\n",
+        "ax.plot(labels, accs, \"o--\", color=\"#FFD700\", lw=1.8, ms=7, zorder=4)\n",
+        "for bar, acc in zip(bars, accs):\n",
