+        "                 \"--format=csv,noheader,nounits\"],\n",
+        "                capture_output=True, text=True, timeout=2\n",
+        "            )\n",
+        "            if smi.returncode == 0:\n",
+        "                vals = smi.stdout.strip().split(\"\\n\")[0].split(\",\")\n",
