+        "            hist[bs][fold] = {\n",
+        "                \"accuracy\": tr_acc, \"val_accuracy\": va_acc,\n",
+        "                \"loss\": tr_loss, \"val_loss\": va_loss,\n",
+        "            }\n",
+        "    return hist\n",
+        "\n",
+        "# 실제 vs 더미 선택\n",
