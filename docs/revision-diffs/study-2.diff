+        "    for i, gpu in enumerate(gpus):\n",
+        "        tf.config.experimental.set_memory_growth(gpu, True)\n",
+        "        print(f\"  ✅ GPU {i}: {gpu.name}  (메모리 동적 할당 활성화)\")\n",
+        "    try:\n",
+        "        result = subprocess.run(\n",
+        "            [\"nvidia-smi\",\n",
