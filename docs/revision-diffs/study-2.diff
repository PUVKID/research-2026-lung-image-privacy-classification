+        "    os.environ[\"TF_DETERMINISTIC_OPS\"] = \"1\"\n",
+        "    random.seed(seed)\n",
+        "    np.random.seed(seed)\n",
+        "    try:\n",
+        "        tf.keras.utils.set_random_seed(seed)\n",
+        "    except AttributeError:\n",
+        "        tf.random.set_seed(seed)\n",
+        "    try:\n",
+        "        tf.config.experimental.enable_op_determinism()\n",
+        "    except Exception:\n",
+        "        pass\n",
