+        "            va_acc = [min(t * rng.uniform(0.90, 0.97), 0.97) for t in tr_acc]\n",
+        "            tr_loss = (1.5 * np.exp(-np.linspace(0, 3, n_ep)) + rng.normal(0, 0.01, n_ep)).tolist()\n",
